# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-api-key>  # Optional if using DefaultAzureCredential

# Microsoft Foundry Project
# The AI Services endpoint (for vectorizers & KB models) is derived automatically
# from the project endpoint by stripping /api/projects/<project>.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<account>/projects/<project>

# Model deployments
LLM_DEPLOYMENT=gpt-5.4-mini
LLM_MODEL=gpt-5.4-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-large

# REST API version targeted by azure-search-documents 12.2.0b1.
# Only used to build the knowledge base MCP endpoint URL in 01-basics/02.
SEARCH_API_VERSION=2026-11-01-preview

# --- Notebooks 00-setup, 02-knowledge-retrieval, 03-graph ---

# Storage account (general-purpose v2, NOT ADLS Gen2) holding the Wikipedia corpus. Access is keyless (Entra ID),
# so shared-key access can stay disabled. Must have Blob soft delete ON and versioning OFF (entity graph requirement),
# and Table storage for the entity graph ingestion cache.
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<account>

# Chat model used to extract the entity graph and to plan graph queries (gpt-5.6-luna recommended).
# Defaults to LLM_DEPLOYMENT / LLM_MODEL when unset.
GRAPH_LLM_DEPLOYMENT=gpt-5.6-luna
GRAPH_LLM_MODEL=gpt-5.6-luna

# Optional: User-Agent for the Wikipedia API (00-setup). Include contact info to avoid 429 throttling.
# WIKI_USER_AGENT=foundry-iq-space-demo/1.0 (you@example.com)
