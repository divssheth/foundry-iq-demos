# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-api-key>  # Optional if using DefaultAzureCredential

# Microsoft Foundry Project
# The AI Services endpoint (for vectorizers & KB models) is derived automatically
# from the project endpoint by stripping /api/projects/<project>.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<account>/projects/<project>

# Model deployments
LLM_DEPLOYMENT=gpt-5.4-mini
LLM_MODEL=gpt-5.4-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-large
